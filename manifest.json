{
	"manifest_version": 2,
	"name": "ReplyAsOriginalRecipientUp",
	"version": "1.3.0",
	"description": "Set your customized address in From: field when replying to an email",
	"applications": {
		"gecko": {
			"id": "ReplyAsOriginalRecipient@github.com",
			"strict_min_version": "91.0"
		}
	},
	"permissions": [
		"compose",
		"tabs",
		"messagesRead",
		"accountsRead"
	],
	"background": {
		"scripts": [
			"background.js"
		]
	}
}